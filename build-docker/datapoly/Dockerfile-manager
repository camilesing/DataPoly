# 基镜像钉 digest（tag 可被上游覆盖，digest 不可变）；升级基镜像时须同步刷新
FROM eclipse-temurin:8-jre-jammy@sha256:06641b36281c1ac815c33f3f3528cfea1c6fc41ddc60d261746e4343d19cbe65

ENV TZ=Asia/Shanghai

# curl 仅供 HEALTHCHECK / compose 健康探测使用；顺手建非 root 用户（须在 COPY --chown 前存在）
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
 && apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -r -u 1001 -d /datapoly-release datapoly

# 直接 COPY 装配目录（而非 ADD tar 包：tar 会额外留一层双倍体积）；--chown 在拷贝层内赋权
COPY --chown=datapoly:datapoly datapoly-release/ /datapoly-release/

USER        datapoly
WORKDIR /datapoly-release

RUN mkdir -p run && chmod u+x bin/datapolyctl.sh

EXPOSE      8090

# 容器内自检（manager 的 /actuator/health 已收窄为 health,info）
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=10 \
  CMD curl -fsS http://localhost:8090/actuator/health || exit 1

CMD  ["/datapoly-release/bin/datapolyctl.sh","manager"]
