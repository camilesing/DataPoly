<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>datapoly-parent</artifactId>
        <groupId>com.cs</groupId>
        <version>1.9.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>datapoly-test</artifactId>

    <description>Centralized unit tests for all DataPoly modules（JUnit 4 + hand-written fakes，无外部服务依赖）</description>

    <dependencies>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-template</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-executor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>datapoly-manager</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 聚合覆盖率：测试全部集中在本模块执行，prepare-agent 采集本模块 exec 数据，
                 report-aggregate 在 verify 阶段聚合各上游模块的类与源码生成统一报告 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
