<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cs</groupId>
    <artifactId>datapoly-parent</artifactId>
    <packaging>pom</packaging>
    <version>1.9.0</version>

    <name>DataPoly</name>
    <description>A tool for quickly building RESTful APIs from SQL, DSL and scripts over 20+ databases</description>
    <url>https://github.com/camilesing/datapoly</url>

    <licenses>
        <license>
            <name>BSD 3-Clause License</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>The DataPoly Authors</name>
            <organization>DataPoly</organization>
            <organizationUrl>https://github.com/camilesing/datapoly</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/camilesing/datapoly</url>
        <connection>scm:git:https://github.com/camilesing/datapoly.git</connection>
        <developerConnection>scm:git:https://github.com/camilesing/datapoly.git</developerConnection>
    </scm>
    <properties>
        <java.version>25</java.version>
        <lombok.version>1.18.48</lombok.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven.test.skip>false</maven.test.skip>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Boot 3.5.x（3.x LTS 线）配 Spring Cloud 2025.0.x + SCA 2025.0.0.0，JDK 基线 25（LTS）；
             Boot 2.6+ 默认拒绝循环依赖（allow-circular-references 见各服务 application.yaml）；
             API 文档由 springdoc 提供（springfox 已停更且不兼容 Boot 3） -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
    </properties>

    <modules>
        <module>datapoly-common</module>
        <module>datapoly-mcp</module>
        <module>datapoly-template</module>
        <module>datapoly-persistence</module>
        <module>datapoly-core</module>
        <module>datapoly-cache</module>
        <module>datapoly-executor</module>
        <module>datapoly-gateway</module>
        <module>datapoly-manager</module>
        <module>datapoly-test</module>
        <module>datapoly-dist</module>
    </modules>

    <dependencyManagement>

        <dependencies>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SCA BOM 统一管理 sentinel 版本：2025.0.0.0 面向 Boot 3.5 / Cloud 2025.0 生态 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>2025.0.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 钉版：Boot BOM 托管的 lombok 落后且需支持 JDK 25 javac（1.18.48 支持 JDK 8~26） -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>5.6.4</version>
            </dependency>

            <!-- hazelcast-all 自 5.0 起停发（IMDG/Jet 合并），改为引入核心 hazelcast 模块 -->
            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast</artifactId>
                <version>5.7.0</version>
            </dependency>

            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast-eureka-one</artifactId>
                <version>2.0.1</version>
            </dependency>

            <!-- 钉版勿回退（见 AGENTS.md）：groovy 3.0.20 的 ASM 不支持新 classfile（如 JDK 25 的 69），
                 脚本编译/沙箱测试会报 Unsupported class file major version；升 4.0.33
                 （4.x 起 groupId 为 org.apache.groovy），本地构建 JDK 8 与 CI temurin 8 均不受影响 -->
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>4.0.33</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>5.8.47</version>
            </dependency>

            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.1-jre</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>4.6.0</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.20.0</version>
            </dependency>

            <!-- springfox 3.0 已停更且不兼容 Boot 3，API 文档换 springdoc（2.8.x 配套 Boot 3.5）；
                 swagger annotations/models 供注解与自研 ApiSwaggerService 使用（-jakarta 变体，包名 io.swagger.v3） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>2.8.17</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>2.2.55</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-models-jakarta</artifactId>
                <version>2.2.55</version>
            </dependency>

            <!-- Connector/J 9.x 不再支持 MySQL 5.7（install compose 仍含 5.7），钉 8.x 末版 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.4.0</version>
            </dependency>

            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>3.0.5</version>
            </dependency>

            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>3.5.19</version>
            </dependency>

            <!-- Boot 3 必须用 mybatis-plus 的 spring-boot3 专用 starter（同版本线） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>3.5.17</version>
            </dependency>

            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>2.1.1</version>
            </dependency>

            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>4.13.2</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


    <build>
        <plugins>
            <!-- 工具链升 25：JDK 23+ 的 javac 不再从 classpath 隐式发现注解处理器（旧 JDK 8 行为），
                 必须经 -processorpath 显式传入 lombok，否则静默不生成 getter/setter/builder 等 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*.xml</exclude>
                        <exclude>**/*.yml</exclude>
                        <exclude>**/*.properties</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 将依赖的jar包拷贝到target目录下 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${basedir}/target</outputDirectory>
                            <excludeTransitive>false</excludeTransitive>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>